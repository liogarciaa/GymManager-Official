<UserControl x:Class="GymManager.Views.PagosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FontFamily="Segoe UI"
             Background="#e1e1e2"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Estilo para encabezados de columnas DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

                <!-- Estilo unificado para los DatePicker -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo unificado para el ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botones de Acceso Rápido de Fecha -->
        <Style x:Key="BtnQuickFilter" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="35" Focusable="True" PreviewMouseDown="Fondo_PreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. ENCABEZADO Y RESUMEN DE RECAUDACIÓN -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Caja y Cobranzas" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Auditoría de ingresos, historial de cobros y conciliación de caja" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Card Resumen Total Recaudado -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" MinWidth="250">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL RECAUDADO" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="TxtTotalRecaudado" Text="$ 0,00" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                        <TextBlock Text="Según filtros seleccionados" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <!-- 2. BARRA DE FILTROS AVANZADA -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,20">
            <WrapPanel VerticalAlignment="Center">
                <!-- Filtro Desde -->
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Fecha Desde:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DpDesde" 
                                Width="140" 
                                Style="{StaticResource ModernDatePicker}"
                                SelectedDateChanged="Filtro_Changed"/>
                </StackPanel>

                <!-- Filtro Hasta -->
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Fecha Hasta:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DpHasta" 
                                Width="140" 
                                Style="{StaticResource ModernDatePicker}"
                                SelectedDateChanged="Filtro_Changed"/>
                </StackPanel>

                <!-- Filtro Método de Pago -->
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Método de Cobro:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbMetodoFiltro" 
                            Width="170" 
                            Style="{StaticResource ModernComboBox}"
                            SelectionChanged="Filtro_Changed">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="Efectivo"/>
                        <ComboBoxItem Content="Transferencia"/>
                        <ComboBoxItem Content="Débito / Crédito"/>
                        <ComboBoxItem Content="Bonificación / Regalo"/>
                    </ComboBox>
                </StackPanel>

                <!-- Accesos Rápidos de Rango -->
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,0">
                    <TextBlock Text="Accesos rápidos:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Hoy" Style="{StaticResource BtnQuickFilter}" Height="36" Margin="0,0,8,0" Click="BtnHoy_Click"/>
                        <Button Content="Este Mes" Style="{StaticResource BtnQuickFilter}" Height="36" Click="BtnEsteMes_Click"/>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 3. GRILLA DE PAGOS -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}">
                <DataGrid x:Name="GridPagos"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    Focusable="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#d2d2d2"
                    Background="White"
                    BorderThickness="0"
                    AlternatingRowBackground="#F8FAFC"
                    RowHeight="42"
                    CanUserResizeRows="False"
                    CanUserSortColumns="False">

                <!-- Quitar recuadro de foco de celda -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" 
                                            BorderThickness="0" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>

                <!-- Fila neutral: sin fondo azul ni cambio de color de texto al cliquear -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                        </Style.Resources>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° Recibo" Binding="{Binding Id}" Width="85" FontWeight="Bold" Foreground="#64748B"/>
                    <DataGridTextColumn Header="Fecha / Hora" Binding="{Binding FechaPago, StringFormat='dd/MM/yyyy  HH:mm'}" Width="150" Foreground="#475569"/>
                    <DataGridTextColumn Header="Socio" Binding="{Binding Socio.NombreCompleto}" Width="2*" FontWeight="SemiBold" Foreground="#0F172A"/>

                    <!-- Importe cobrado -->
                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat='C2'}" Width="120" FontWeight="Bold" Foreground="#16A34A"/>

                    <!-- Método de cobro formateado como Badge -->
                    <DataGridTemplateColumn Header="Forma de Cobro" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Background="#F1F5F9">
                                    <TextBlock Text="{Binding FormaDePago}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Período Cubierto -->
                    <DataGridTemplateColumn Header="Período Acreditado" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#334155">
                                        <Run Text="{Binding FechaInicio, StringFormat='dd/MM/yyyy'}" FontWeight="SemiBold"/>
                                        <Run Text=" - " Foreground="#94A3B8"/>
                                        <Run Text="{Binding FechaVencimiento, StringFormat='dd/MM/yyyy'}" FontWeight="Bold" Foreground="#0F172A"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>